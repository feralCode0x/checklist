{
  "name": "checklist",
  "homepage": "https://feralCode0x.github.io/checklist",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "predeploy": "npx expo export -p web && sed -i 's|src=\"/|src=\"/checklist/|g; s|href=\"/|href=\"/checklist/|g' dist/index.html",
    "deploy": "gh-pages -d dist -t --nojekyll"
  },
  "dependencies": {
    "@expo/vector-icons": "^13.0.0",
    "@expo/webpack-config": "^19.0.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@supabase/supabase-js": "2.38.4",
    "expo": "~49.0.15",
    "expo-auth-session": "~5.0.2",
    "expo-crypto": "~12.4.1",
    "expo-status-bar": "~1.6.0",
    "expo-web-browser": "~12.3.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-screens": "~3.22.0",
    "react-native-web": "~0.19.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "gh-pages": "^6.3.0"
  },
  "overrides": {
    "@supabase/gotrue-js": "2.56.0",
    "@supabase/postgrest-js": "1.8.5",
    "@supabase/realtime-js": "2.8.4",
    "@supabase/storage-js": "2.5.4",
    "@supabase/functions-js": "2.1.5"
  },
  "private": "true"
}
